+def _regular_checkpoint_file(filename):
+    """Reject nonregular checkpoint inputs before opening a potentially blocking file."""
+    try:
+        regular = stat.S_ISREG(os.stat(filename).st_mode)
+    except (OSError, ValueError, TypeError):
+        regular = False
+    if not regular:
+        raise ValueError("Checkpoint inputs must be existing regular files.")
+
+
+def _checkpoint_shard_path(checkpoint_folder, shard, require_local_file=True):
+    """Confine index-controlled paths while retaining trusted Hub snapshot links.
+
+    This validates an on-disk checkpoint tree, not concurrent modification by
+    another local filesystem writer. Keep the logical filename for safetensors
+    backend selection; a Hub blob's physical filename has no extension.
+    """
+    if not isinstance(shard, str) or not shard or "\x00" in shard:
+        raise ValueError("Checkpoint shard names must be nonempty strings without NUL.")
+    relative = Path(shard)
+    if relative.anchor or ".." in relative.parts:
+        raise ValueError("Checkpoint shard names must stay relative to the checkpoint folder.")
+    if os.name == "nt" and any(":" in part or PureWindowsPath(part).is_reserved() for part in relative.parts):
+        raise ValueError("Checkpoint shard names cannot contain Windows streams or devices.")
+    filename = os.path.join(checkpoint_folder, shard)
+    if not require_local_file:
+        # Broadcast receivers validate metadata but never open local shards.
+        return filename
+    folder = Path(os.path.realpath(checkpoint_folder))
+    target = Path(os.path.realpath(filename))
+    allowed = target.is_relative_to(folder)
+    if not allowed:
+        # A caller-selected Hub snapshot authorizes that repository's blob
+        # store, including when snapshot_download used an explicit cache_dir.
+        # Derive its repository only from the caller's checkpoint folder, never
+        # from index metadata. An escaping blob-store reparse point is invalid.
+        for snapshot in (folder, *folder.parents):
+            if (
+                snapshot.parent.name == "snapshots"
+                and snapshot.parent.parent.name.startswith("models--")
+                and re.fullmatch(r"[0-9a-fA-F]{40}", snapshot.name) is not None
+            ):
+                repository = snapshot.parent.parent
+                blob_store = Path(os.path.realpath(repository / "blobs"))
+                allowed = blob_store.is_relative_to(repository) and target.is_relative_to(blob_store)
+                break
+    if not allowed:
+        raise ValueError("Checkpoint shard resolves outside its authorized checkpoint storage.")
+    _regular_checkpoint_file(filename)
+    return filename
+
