engine-strict=true
min-release-age=14
strict-allow-scripts=true

# Reviewed security fixes remain exactly pinned in package.json. npm's age
# exceptions match package names, so they must not replace those exact pins.
min-release-age-exclude[]=electron
min-release-age-exclude[]=sanitize-html
min-release-age-exclude[]=follow-redirects
min-release-age-exclude[]=dompurify
min-release-age-exclude[]=ip-address
min-release-age-exclude[]=postcss
min-release-age-exclude[]=vitest
min-release-age-exclude[]=@vitest/*
min-release-age-exclude[]=vite
# Required native bundler closure of the reviewed Vite security release.
min-release-age-exclude[]=rolldown
min-release-age-exclude[]=@rolldown/binding-*
min-release-age-exclude[]=@oxc-project/types
# Reviewed advisory floors (undici GHSA-*, fast-uri GHSA-*, wait out 14d age).
min-release-age-exclude[]=undici
min-release-age-exclude[]=fast-uri
min-release-age-exclude[]=zod
min-release-age-exclude[]=deepmerge

# Native install-script approvals and permanent denials live in allowScripts
# in package.json; there is no blanket script-execution permission here.
shamefully-hoist=true
confirmModulesPurge=false
